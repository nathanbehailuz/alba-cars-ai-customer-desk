      "parameters": {
        "jsCode": "const ctx = $('Customer Lookup Result').first().json;\nconst payload = ctx.payload;\nlet customerId = ctx.customerId;\nconst upd = $('Update Customer').first()?.json;\nconst crt = $('Create Customer').first()?.json;\nif (!customerId) {\n  if (Array.isArray(upd) && upd[0]?.id) customerId = upd[0].id;\n  else if (Array.isArray(crt) && crt[0]?.id) customerId = crt[0].id;\n  else if (upd?.id) customerId = upd.id;\n  else if (crt?.id) customerId = crt.id;\n}\nif (!customerId) {\n  throw new Error('Customer upsert failed');\n}\nreturn [{ json: { payload, customerId } }];"
      },
