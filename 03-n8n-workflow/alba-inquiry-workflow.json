    {
      "parameters": {
        "jsCode": "const base = $('Resolve Customer Id').first().json;\nconst rpc = $('Get Lead Reference RPC').first().json;\nlet reference = null;\nif (typeof rpc === 'string') reference = rpc;\nelse if (Array.isArray(rpc) && rpc[0]) reference = String(rpc[0]);\nelse if (rpc && typeof rpc === 'object' && !rpc.error) reference = String(Object.values(rpc)[0] || '');\nif (!reference || reference === 'undefined') {\n  const seq = String(Date.now()).slice(-5);\n  reference = `AC-${seq}`;\n}\nreturn [{ json: { ...base, reference } }];"
      },
