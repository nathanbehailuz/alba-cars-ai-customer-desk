    {
      "parameters": {
        "jsCode": "const ctx = $('Assign Reference').first().json;\nconst ref = ctx.reference;\nconst payload = ctx.payload;\nconst fallback = {\n  category: payload.category_seed || 'general_sales_question',\n  summary: payload.message || 'Website inquiry received.',\n  vehicle: {},\n  buying_timeline: 'unknown',\n  buying_intent: 'medium',\n  urgency: 'medium',\n  lead_score: 45,\n  recommended_action: 'Review inquiry and contact customer.',\n  recommended_cta: 'manual_follow_up',\n  voice_agent_eligible: false,\n  customer_confirmation: `Thanks for contacting ALBA CARS. We received your inquiry. Reference ${ref}.`,\n  sales_brief: `Fallback lead ${ref} — AI classification unavailable.`\n};\nreturn [{ json: { ...ctx, aiParsed: fallback, aiRaw: { fallback: true, error: $input.first().json } } }];"
      },
      "id": "a1b2c3d4-0022-4000-8000-000000000022",
      "name": "AI Fallback Template",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [4320, 560]
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Assign Reference').first().json;\nconst openai = $('OpenAI Classify').first().json;\nlet parsed;\ntry {\n  const content = openai.choices?.[0]?.message?.content || '{}';\n  parsed = typeof content === 'string' ? JSON.parse(content) : content;\n} catch (e) {\n  parsed = { summary: 'Parse error', lead_score: 40, category: 'general_sales_question' };\n}\nreturn [{ json: { ...ctx, aiParsed: parsed, aiRaw: openai } }];"
      },
      "id": "a1b2c3d4-0023-4000-8000-000000000023",
      "name": "Extract OpenAI JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [4080, 280]
    },
    {
      "parameters": {
        "jsCode": "const item = $input.first().json;\nconst payload = item.payload;\nconst parsed = item.aiParsed || {};\nlet score = Number(parsed.lead_score);\nif (Number.isNaN(score)) score = 0;\nscore = Math.max(0, Math.min(100, Math.round(score)));\nlet priority = 'early';\nif (score >= 80) priority = 'hot';\nelse if (score >= 50) priority = 'warm';\nconst voiceEligible = Boolean(parsed.voice_agent_eligible) && Boolean(payload.phone) && Boolean(payload.voice_consent);\nparsed.voice_agent_eligible = voiceEligible;\nparsed.lead_score = score;\nconst confirmation = parsed.customer_confirmation || `Thanks for contacting ALBA CARS. Reference ${item.reference}.`;\nreturn [{ json: { ...item, parsed, score, priority, voiceEligible, confirmation } }];"
      },
      "id": "a1b2c3d4-0024-4000-8000-000000000024",
      "name": "Parse AI and Apply Rules",
