        "jsCode": "const payload = $input.first().json.body ?? $input.first().json;\nconst errors = [];\nif (!payload?.submission_id) errors.push('submission_id required');\nif (!payload?.email && !payload?.phone) errors.push('email or phone required');\nif (!payload?.contact_consent) errors.push('contact_consent required');\nconst ch = payload?.preferred_channel;\nif ((ch === 'whatsapp' || ch === 'both') && !payload?.phone) {\n  errors.push('phone required for WhatsApp channel');\n}\nif ((ch === 'email' || ch === 'both') && !payload?.email) {\n  errors.push('email required for email channel');\n}\nif (errors.length) {\n  return [{ json: { valid: false, errors, payload } }];\n}\nreturn [{ json: { valid: true, payload } }];"
