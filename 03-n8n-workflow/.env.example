# n8n Cloud: Personal → Variables ($vars). Never commit real values.
# Self-host / local runners may use the same names as environment variables.

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-nano

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional — if unset, communication rows use delivery_status=skipped with drafted body
EMAIL_PROVIDER=
WHATSAPP_PROVIDER=
SALES_ALERT_PROVIDER=
