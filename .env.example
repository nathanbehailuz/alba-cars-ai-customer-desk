# Shared — copy to .env / folder .env.local; never commit real values

# Supabase (grid150 hosts Alba as alba_* tables — separate from topics/problems)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# OpenAI (n8n credential or server-side only — never NEXT_PUBLIC_)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-nano

# n8n webhook the web app posts inquiries to
N8N_WEBHOOK_URL=https://YOUR_N8N_HOST/webhook/alba-inquiry
NEXT_PUBLIC_N8N_WEBHOOK_URL=https://YOUR_N8N_HOST/webhook/alba-inquiry

# Optional outbound
RESEND_API_KEY=
SALES_ALERT_EMAIL=sales@example.com
APPOINTMENT_URL=https://calendly.com/example
WHATSAPP_API_URL=
WHATSAPP_API_TOKEN=

# Business config
BRANCH_TIMEZONE=Asia/Dubai
WORKING_HOURS_START=09:30
WORKING_HOURS_END=22:00
